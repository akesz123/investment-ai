# Environment configuration for Investment AI
# Copy this file to .env and adjust values as needed.

APP_NAME="Investment AI"
DEBUG=true

# Database configuration
# For SQLite (default)
DATABASE_URL="sqlite:///./investment_ai.db"
# For PostgreSQL (example)
# DATABASE_URL="postgresql+psycopg2://user:password@postgres:5432/investment_ai"

# External API keys (optional but recommended)
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""
FMP_API_KEY=""
NEWSAPI_API_KEY=""

# Macro / sentiment sources (if applicable)
FRED_API_KEY=""

# Security
SECRET_KEY="change_this_in_production"
